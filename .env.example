# Public site and proxy
VOLUMA_ENVIRONMENT=development
VOLUMA_PUBLIC_ORIGIN=http://localhost:3000
VOLUMA_DEFAULT_LOCALE=en

# Frontend -> API. Development only; production is same-origin through Nginx.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostgreSQL: use a distinct protected secret outside version control.
POSTGRES_DB=voluma
POSTGRES_USER=voluma
POSTGRES_PASSWORD=replace-with-a-unique-local-development-password
DATABASE_URL=postgresql+psycopg://voluma:replace-with-a-unique-local-development-password@postgres:5432/voluma

# Redis database 0: cache, sessions, and rate limits. Database 1: Celery broker.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Generated deployment-only values. Never use these placeholders in a deployed environment.
VOLUMA_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
VOLUMA_CSRF_SECRET=replace-with-a-random-secret-at-least-32-characters-long
VOLUMA_INITIAL_ADMIN_EMAIL=owner@example.com
VOLUMA_INITIAL_ADMIN_PASSWORD=replace-with-a-one-time-protected-password

# Shared mounted media root; originals and staging are never served publicly.
VOLUMA_MEDIA_ROOT=/var/lib/voluma-media
