# Development-only local configuration. Production uses protected deployment
# configuration with VOLUMA_ENVIRONMENT=production and an HTTPS public origin.
VOLUMA_ENVIRONMENT=development
VOLUMA_PUBLIC_ORIGIN=http://localhost:3000
VOLUMA_DEFAULT_LOCALE=en
VOLUMA_IMAGE_TAG=local

# Frontend -> API. Development only; production is same-origin through Nginx.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostgreSQL: use a distinct protected secret outside version control.
POSTGRES_DB=voluma
POSTGRES_USER=voluma
POSTGRES_PASSWORD=replace-with-a-unique-local-development-password
DATABASE_URL=postgresql+psycopg://voluma:replace-with-a-unique-local-development-password@127.0.0.1:54329/voluma

# Redis database 0: cache, sessions, and rate limits. Database 1: Celery broker.
REDIS_PASSWORD=replace-with-a-unique-local-development-password
REDIS_URL=redis://:replace-with-a-unique-local-development-password@127.0.0.1:56379/0
CELERY_BROKER_URL=redis://:replace-with-a-unique-local-development-password@127.0.0.1:56379/1
VOLUMA_DEV_POSTGRES_PORT=54329
VOLUMA_DEV_REDIS_PORT=56379

# The idempotent provisioning command runs only through the bootstrap profile.
# Never use these placeholders in a deployed environment.
VOLUMA_INITIAL_ADMIN_EMAIL=owner@example.com
VOLUMA_INITIAL_ADMIN_PASSWORD=replace-with-a-one-time-protected-password

# Shared mounted media root; originals and staging are never served publicly.
VOLUMA_MEDIA_ROOT=/var/lib/voluma-media
# FastAPI remains authoritative at 50 MiB; Nginx permits 60 MiB for multipart overhead.
# The Celery worker and API must mount this same root read/write. Nginx mounts only public/ read-only.

# Production-only absolute host paths. These files are mounted read-only into Nginx.
VOLUMA_TLS_CERT_PATH=/absolute/path/to/fullchain.pem
VOLUMA_TLS_KEY_PATH=/absolute/path/to/privkey.pem

# Backup encryption and destination are provided only to the host backup operation.
VOLUMA_BACKUP_ENCRYPTION_PASSWORD=replace-with-a-long-random-backup-password
VOLUMA_OFFSITE_BACKUP_DIR=/absolute/path/to/encrypted-offsite-backup-destination
